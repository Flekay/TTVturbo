# TTVturbo environment configuration example.
#
# Copy to .env and fill in real values. The .env file is git-ignored and
# must never be committed. The server reads these via os.environ at start.

# --- VOD Pipeline (Twitch) --------------------------------------------------
# No Twitch API credentials needed. yt-dlp handles channel VOD/clip listing,
# metadata fetch and downloads entirely on its own (it uses Twitch's GraphQL
# endpoint internally). Just install yt-dlp and ffprobe and you're done.
#
# Required tooling:
#   - yt-dlp  (https://github.com/yt-dlp/yt-dlp#installation)
#   - ffprobe (bundled with ffmpeg, https://ffmpeg.org/download.html)
# Both must be on the system PATH so the backend can spawn them.

# --- Data directories -------------------------------------------------------
# Root data directory for ALL runtime state (recordings, voice clones,
# voice profiles, Twitch profiles, VODs, library, media jobs, pipeline
# runs). Defaults to ./data next to the app.
# TTVTURBO_DATA_DIR=

# Where VOD metadata + temp download files are stored (session data).
# Defaults to <data-dir>/vods.
# TTVTURBO_VOD_DOWNLOAD_DIR=

# Where the persistent library stores downloaded VOD files + uploads.
# Defaults to <data-dir>/library.
# TTVTURBO_LIBRARY_DIR=

# --- Download worker tuning -------------------------------------------------
# Per-VOD download timeout in seconds. 0 = no artificial timeout, which is
# the default so multi-hour VODs are not killed prematurely.
# TTVTURBO_VOD_DOWNLOAD_TIMEOUT_SECONDS=0

# Maximum number of concurrent VOD downloads. Default 1 (one at a time).
# TTVTURBO_MAX_CONCURRENT_VOD_DOWNLOADS=1

# Maximum number of VODs + clips pulled in a single sync (newest first).
# Default 100.
# TTVTURBO_VOD_SYNC_LIMIT=100

# --- Voice profiles (pre-existing) ------------------------------------------
# TTVTURBO_VOICE_PROFILES_DIR=

# --- Voice clone (pre-existing) ---------------------------------------------
# TTVTURBO_VOICE_CLONE_TIMEOUT_SECONDS=300

# --- Transcription (faster-whisper) -----------------------------------------
# The transcription worker runs in a separate subprocess and imports
# faster-whisper lazily. These variables control the model, device and
# compute type. Install requirements-gpu.txt to enable CUDA transcription.
#
# Required tooling:
#   - ffmpeg + ffprobe (for audio extraction and verification)
#   - faster-whisper (install via requirements-gpu.txt)
#
# Model name. Default: large-v3
# TTVTURBO_TRANSCRIPTION_MODEL=large-v3
#
# Device: "cuda" for GPU, "cpu" for CPU. Default: cuda.
# Set to "cpu" only if you don't have a CUDA GPU (will be very slow).
# TTVTURBO_TRANSCRIPTION_DEVICE=cuda
#
# Compute type for faster-whisper. Default: int8_float16 (best for 12 GB GPUs).
# See https://github.com/SYSTRAN/faster-whisper/blob/master/docs/compute_type.md
# TTVTURBO_TRANSCRIPTION_COMPUTE_TYPE=int8_float16
#
# Default language code for transcription. Default: de (German).
# Set to "auto" for automatic language detection.
# TTVTURBO_TRANSCRIPTION_LANGUAGE=de
#
# Maximum concurrent transcription jobs. Default 1 (one at a time, shared
# GPU with voice-clone via the cross-process GPU lock).
# TTVTURBO_MAX_CONCURRENT_TRANSCRIPTIONS=1

# --- Conversation Mining (local text LLM, transformers worker) ---------------
# The mining worker runs in a separate subprocess and imports transformers /
# torch lazily. The FastAPI process never imports them. Install
# requirements-gpu.txt to enable CUDA mining.
#
# HuggingFace repo id of the text model. Default: Qwen/Qwen3-4B-Instruct-2507
# (text-only, run in non-thinking mode). Override only to pin a different
# revision of the same family; free-form model names from the frontend are
# never accepted.
# TTVTURBO_CONVERSATION_MINING_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
#
# Device: "cuda" for GPU, "cpu" for CPU. Default: cuda.
# TTVTURBO_CONVERSATION_MINING_DEVICE=cuda
#
# dtype: "auto", "bfloat16", "float16" or "float32". Default: auto.
# TTVTURBO_CONVERSATION_MINING_DTYPE=auto
#
# Max new tokens generated per block. Default 2048.
# TTVTURBO_CONVERSATION_MINING_MAX_NEW_TOKENS=2048
#
# Max input tokens per block prompt (conservative cap for a 12 GB GPU).
# The model's full context length is NOT used as the runtime default.
# Default 8192.
# TTVTURBO_CONVERSATION_MINING_MAX_INPUT_TOKENS=8192
#
# Qwen3 thinking mode. Default disabled (0) so the model returns JSON
# directly without  thinking blocks. Set to 1 only for debugging.
# TTVTURBO_CONVERSATION_MINING_THINKING=0
#
# Maximum concurrent mining runs. Default 1.
# TTVTURBO_MAX_CONCURRENT_MINING=1

# --- Video Generation (diffusers CogVideoX worker) --------------------------
# The video-generation worker runs in a separate subprocess and imports
# diffusers / torch lazily. The FastAPI process never imports them.
# Install requirements-gpu.txt (plus diffusers) to enable generation.
# Without it the service reports `available=false` and rejects jobs.
#
# Concrete local adapter: diffusers CogVideoX family.
#   TEXT_TO_VIDEO  -> CogVideoXPipeline
#   IMAGE_TO_VIDEO -> CogVideoXImageToVideoPipeline
#
# HuggingFace repo id for text-to-video. Empty by default (opt-in).
# Example: THUDM/CogVideoX-2b
# TTVTURBO_VIDEO_GENERATION_T2V_MODEL_ID=
#
# HuggingFace repo id for image-to-video. Empty by default (opt-in).
# Example: THUDM/CogVideoX1.5-5B-I2V
# TTVTURBO_VIDEO_GENERATION_I2V_MODEL_ID=
#
# Device: "cuda" for GPU, "cpu" for CPU. Default: cuda.
# TTVTURBO_VIDEO_GENERATION_DEVICE=cuda
#
# dtype: "auto", "bfloat16", "float16" or "float32". Default: bfloat16.
# TTVTURBO_VIDEO_GENERATION_DTYPE=bfloat16
#
# Output frame rate (CogVideoX native rate). Default 8.
# TTVTURBO_VIDEO_GENERATION_FPS=8
#
# Maximum generation duration in seconds. Default 10.
# TTVTURBO_VIDEO_GENERATION_MAX_DURATION_SECONDS=10
#
# Maximum prompt length in characters. Default 1000.
# TTVTURBO_VIDEO_GENERATION_MAX_PROMPT_LENGTH=1000
#
# Maximum concurrent generation jobs. Default 1 (shared GPU via the
# cross-process GPU lock).
# TTVTURBO_MAX_CONCURRENT_VIDEO_GENERATION=1

# --- Ideas Research (trend research -> video ideas -> scripts) ---------------
# The research backend uses pluggable adapters to find current sources.
# No API key is needed for Reddit, RSS or Google Trends.  YouTube, X
# (Twitter) and TikTok require keys.  The LLM adapter for idea/script
# generation is configured separately (see TTVTURBO_IDEAS_RESEARCH_MODEL_ID
# above).
#
# Instruct model id (e.g. OpenAI/Anthropic/local). Empty = unavailable.
# TTVTURBO_IDEAS_RESEARCH_MODEL_ID=
#
# Optional thinking-profile model for complex idea/script generation.
# TTVTURBO_IDEAS_RESEARCH_THINKING_MODEL_ID=
#
# Which research providers to enable (comma-separated).
# Default: rss,google_trends  (add reddit, youtube, twitter, tiktok when
# their keys are configured)
# TTVTURBO_IDEAS_RESEARCH_PROVIDERS=rss,google_trends
#
# YouTube Data API v3 key. Without it the YouTube adapter is skipped.
# Get one at https://console.cloud.google.com/apis/library/youtube.googleapis.com
# YOUTUBE_API_KEY=
#
# X (Twitter) API v2 Bearer Token. Without it the Twitter/X adapter is
# skipped. Get one at https://developer.x.com/en/portal/dashboard
# X_BEARER_TOKEN=
#
# TikTok Research API credentials. Without them the TikTok adapter is
# skipped. Register at https://developers.tiktok.com/
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
#
# Reddit OAuth2 credentials. Reddit now requires OAuth2 for all API
# access. Register a "script" app at https://www.reddit.com/prefs/apps
# Without them the Reddit adapter is skipped.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
#
# Comma-separated subreddits for the Reddit adapter.
# TTVTURBO_IDEAS_RESEARCH_SUBREDDITS=gaming,Games,LivestreamFail,Twitch
#
# Comma-separated RSS feed URLs for the RSS adapter. Leave empty to use
# the built-in defaults (IGN, PC Gamer, Eurogamer, Kotaku).
# TTVTURBO_IDEAS_RESEARCH_RSS_FEEDS=
#
# Maximum concurrent ideas-research runs. Default 1.
# TTVTURBO_MAX_CONCURRENT_IDEAS_RESEARCH=1
#
# Default time range for a research run (e.g. 7d, 24h, 30d). Default 7d.
# TTVTURBO_IDEAS_RESEARCH_DEFAULT_TIME_RANGE=7d
#
# Maximum number of topics kept after clustering/scoring. Default 20.
# TTVTURBO_IDEAS_RESEARCH_DEFAULT_MAX_TOPICS=20

# --- Generic Video Upscale --------------------------------------------------
# AUTO selects Real-ESRGAN when the configured executable is available and
# otherwise uses the fully functional deterministic Lanczos backend.
# TTVTURBO_VIDEO_UPSCALE_BACKEND=AUTO
# TTVTURBO_REALESRGAN_PATH=C:\tools\realesrgan-ncnn-vulkan.exe
# TTVTURBO_REALESRGAN_MODEL=realesrgan-x4plus
# TTVTURBO_MAX_CONCURRENT_VIDEO_UPSCALE=1
# --- Generic Video Background Removal --------------------------------------
# rembg model used for AUTO_FOREGROUND and general foreground extraction.
# TTVTURBO_VIDEO_BACKGROUND_MODEL=isnet-general-use
# Dedicated model used by PERSON mode.
# TTVTURBO_VIDEO_BACKGROUND_PERSON_MODEL=u2net_human_seg
# Device: cpu or cuda. CUDA requires the rembg GPU extra / ONNX CUDA runtime.
# TTVTURBO_VIDEO_BACKGROUND_DEVICE=cpu
# TTVTURBO_MAX_CONCURRENT_VIDEO_BACKGROUND_REMOVAL=1
# --- Text-guided Video Inpaint / Edit --------------------------------------
# Inpainting model for masked changes.
# TTVTURBO_VIDEO_INPAINT_MODEL=stable-diffusion-v1-5/stable-diffusion-inpainting
# Instruction editing model for whole-frame natural-language edits.
# TTVTURBO_VIDEO_INSTRUCTION_EDIT_MODEL=timbrooks/instruct-pix2pix
# TTVTURBO_VIDEO_TEXT_EDIT_DEVICE=cuda
# TTVTURBO_VIDEO_TEXT_EDIT_DTYPE=float16
# TTVTURBO_VIDEO_TEXT_EDIT_CACHE_DIR=
# Maximum working-image side; output is restored to the source dimensions.
# TTVTURBO_VIDEO_TEXT_EDIT_MAX_SIDE=768
# TTVTURBO_MAX_CONCURRENT_VIDEO_TEXT_EDIT=1
