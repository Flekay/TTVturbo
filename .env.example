# TTVturbo environment configuration example.
#
# Copy to .env and fill in real values. The .env file is git-ignored and
# must never be committed. The server reads these via os.environ at start.

# --- VOD Pipeline (Twitch) --------------------------------------------------
# No Twitch API credentials needed. yt-dlp handles channel VOD/clip listing,
# metadata fetch and downloads entirely on its own (it uses Twitch's GraphQL
# endpoint internally). Just install yt-dlp and ffprobe and you're done.
#
# Required tooling:
#   - yt-dlp  (https://github.com/yt-dlp/yt-dlp#installation)
#   - ffprobe (bundled with ffmpeg, https://ffmpeg.org/download.html)
# Both must be on the system PATH so the backend can spawn them.

# --- Data directories -------------------------------------------------------
# Root data directory for the VOD pipeline (Twitch profiles + VOD metadata).
# Defaults to ./ttvturbo_data next to the app.
# TTVTURBO_DATA_DIR=

# Where downloaded VOD video files are stored. Defaults to <data-dir>/vods.
# TTVTURBO_VOD_DOWNLOAD_DIR=

# --- Download worker tuning -------------------------------------------------
# Per-VOD download timeout in seconds. 0 = no artificial timeout, which is
# the default so multi-hour VODs are not killed prematurely.
# TTVTURBO_VOD_DOWNLOAD_TIMEOUT_SECONDS=0

# Maximum number of concurrent VOD downloads. Default 1 (one at a time).
# TTVTURBO_MAX_CONCURRENT_VOD_DOWNLOADS=1

# Maximum number of VODs + clips pulled in a single sync (newest first).
# Default 100.
# TTVTURBO_VOD_SYNC_LIMIT=100

# --- Voice profiles (pre-existing) ------------------------------------------
# TTVTURBO_VOICE_PROFILES_DIR=

# --- Voice clone (pre-existing) ---------------------------------------------
# TTVTURBO_VOICE_CLONE_TIMEOUT_SECONDS=300
