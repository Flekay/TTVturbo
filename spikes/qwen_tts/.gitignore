# Spike-local gitignore. The repo-level .gitignore is protected and must
# not be touched by this spike, so generated artefacts are ignored here.

# Generated audio (real model outputs are large and not source)
output/*.wav
output/*.flac
output/*.mp3

# Generated metrics / reports from real runs (regenerated on each hardware run)
*.metrics.json
output/*.metrics.json

# HuggingFace / ModelScope model caches - never commit weights
.cache/
models/
Qwen3-TTS-*/
*.safetensors
*.bin
*.ckpt

# Python
__pycache__/
*.py[codz]
.pytest_cache/
